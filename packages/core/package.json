{
  "name": "@circuit/core",
  "version": "0.1.0",
  "description": "Pure-TypeScript circuit simulation engine for the Intelligent Circuit Lab (zero DOM dependency).",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench": "tsx tests/benchmarks.test.ts",
    "test": "tsx tests/benchmarks.test.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
